AWS_REGION=us-east-1
HARK_MEMORY_DATABASE_URL=postgresql://hark_memory:REPLACE_ME@HOST:26257/defaultdb?sslmode=verify-full
HARK_DIAGNOSTIC_DATABASE_URL=postgresql://hark_diagnostic:REPLACE_ME@HOST:26257/defaultdb?sslmode=verify-full
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
GEMINI_API_KEY=REPLACE_ME
GEMINI_PRIMARY_MODEL_ID=gemini-3.5-flash-lite
GEMINI_TERTIARY_MODEL_ID=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-2
EMBEDDING_DIMENSIONS=256
MEMORY_SIMILARITY_THRESHOLD=0.73
BEDROCK_HEALTH_TTL_SECONDS=300
HARK_GEMINI_35_REQUEST_BUDGET_PER_DAY=200
HARK_GEMINI_31_REQUEST_BUDGET_PER_DAY=100
HARK_GEMINI_EMBEDDING_REQUEST_BUDGET_PER_DAY=150
HARK_GEMINI_35_REQUEST_LIMIT_PER_MINUTE=12
HARK_GEMINI_31_REQUEST_LIMIT_PER_MINUTE=12
HARK_GEMINI_EMBEDDING_REQUEST_LIMIT_PER_MINUTE=90
DEMO_RUN_LIMIT_PER_DAY=4
GLOBAL_RUN_LIMIT_PER_DAY=40
GLOBAL_TOTAL_RUN_LIMIT=1000
MAX_CONCURRENT_RUNS=3
MAX_AGENT_ITERATIONS=5
RUN_TIMEOUT_SECONDS=60
DEMO_RETENTION_DAYS=45
EXECUTION_ENABLED=true
