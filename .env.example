AWS_REGION=us-east-1
HARK_MEMORY_DATABASE_URL=postgresql://hark_memory:REPLACE_ME@HOST:26257/defaultdb?sslmode=verify-full
HARK_DIAGNOSTIC_DATABASE_URL=postgresql://hark_diagnostic:REPLACE_ME@HOST:26257/defaultdb?sslmode=verify-full
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=256
MEMORY_SIMILARITY_THRESHOLD=0.72
DEMO_RUN_LIMIT_PER_DAY=4
GLOBAL_RUN_LIMIT_PER_DAY=200
GLOBAL_TOTAL_RUN_LIMIT=1000
MAX_CONCURRENT_RUNS=3
MAX_AGENT_ITERATIONS=5
RUN_TIMEOUT_SECONDS=60
DEMO_RETENTION_DAYS=45
EXECUTION_ENABLED=true
